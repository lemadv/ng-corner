FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Expose port for Angular dev server
EXPOSE 4200

# Start the frontend in development mode
CMD ["npx", "nx", "serve", "blog", "--configuration=development", "--host", "0.0.0.0", "--port", "4200"]