FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Generate Prisma client
RUN npx prisma generate --schema=./apps/blog-be/prisma/schema.prisma

# Expose port for Express server
EXPOSE 3333

# Start the backend in development mode
CMD ["sh", "-c", "npx prisma generate --schema=./apps/blog-be/prisma/schema.prisma && npx nx serve blog-be --configuration=development --host 0.0.0.0"]